{
    "name": "dbravoan/dbcms-module-blog",
    "type": "dbcms-module",
    "description": "Multi-author, multi-market blog engine with categories, tags, reading time, and embeddable widgets",
    "license": "MIT",
    "require": {
        "dbravoan/dbcms-core": "~0.0.1"
    },
    "autoload": {
        "psr-4": {
            "DbCms\\Modules\\Blog\\": "./"
        }
    },
    "extra": {
        "dbcms": {
            "name": "Blog Engine",
            "identifier": "blog",
            "author": "dbCMS Core Team",
            "description": "Multi-author, multi-market blog engine with categories, tags, reading time, and embeddable widgets",
            "provider": "DbCms\\Modules\\Blog\\BlogModuleServiceProvider",
            "is_pageable": true,
            "repository": "https://github.com/dbravoan/dbcms-module-blog",
            "morphs": {
                "post": "DbCms\\Modules\\Blog\\Models\\Post",
                "blog_category": "DbCms\\Modules\\Blog\\Models\\Category"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "fixture:lock": "@php tooling/package.php fixture:lock",
        "prepare": "@php tooling/package.php prepare",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php tooling/package.php test"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@php tooling/package.php check"
        ],
        "test:dist": [
            "Composer\\Config::disableProcessTimeout",
            "@php tooling/package.php test:dist"
        ],
        "profiles": "@php tooling/package.php profiles"
    },
    "archive": {
        "exclude": [
            "/.build",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/tests",
            "/tooling",
            "/docker",
            "/AGENTS.md",
            "/compose.yaml",
            "/pint.json",
            "/phpunit.xml",
            "/.node-version",
            "/.dockerignore",
            "/.env",
            "/.env.*",
            "/node_modules",
            "/vendor"
        ]
    }
}
